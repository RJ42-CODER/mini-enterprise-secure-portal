# ==============================================================================
# SECURE PORTAL & SECURITY AGENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure values for your environment.
# DO NOT commit real secrets or credentials into version control.
# ==============================================================================

# Protected Server Configuration
CN_SERVER_IP=192.168.31.91
PORT=5000

# Optional Portal Admin Credential Override (default: admin / admin123)
PORTAL_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Defensive SOC Dashboard Ingestion Integration
SOC_URL=http://192.168.31.73:8443
# Telemetry Bearer Token (both SOC_API_KEY and SOC_AGENT_TOKEN are accepted)
SOC_API_KEY=REPLACE_WITH_REAL_SOC_API_KEY
SOC_AGENT_TOKEN=REPLACE_WITH_REAL_SOC_AGENT_TOKEN

# Optional Custom Ingestion Endpoint Override (defaults to ${SOC_URL}/api/events)
# SOC_EVENTS_ENDPOINT=http://192.168.31.73:8443/api/events

# Network Telemetry Sniffer (Linux VM / Host-Only Adapter)
SNIFFER_INTERFACE=enp0s8
SNIFFER_ALLOW_LOCALHOST=True
MONITORED_PORTS=21,22,80,443,5050,8080

# Port Scan Detection Controls (Sliding-Window Aggregator)
# Threshold of distinct destination ports probed within window to trigger aggregated PORT_SCAN alert
PORT_SCAN_THRESHOLD=5
PORT_SCAN_WINDOW_SECONDS=60
PORT_SCAN_COOLDOWN_SECONDS=30
PORT_SCAN_SEVERITY=HIGH

# ==============================================================================
# Web Application Firewall (WAF) & Request Filtering Controls
# ==============================================================================
# Enforcement mode: 'BLOCK' (active rejection) or 'MONITOR' (audit and telemetry only)
WAF_MODE=BLOCK

# Flask backend binding host ('127.0.0.1' ensures external clients cannot bypass Nginx reverse-proxy WAF)
FLASK_HOST=127.0.0.1

# Maximum permitted HTTP request body size (in bytes, default: 1048576 = 1 MB)
WAF_MAX_CONTENT_LENGTH=1048576

# Whitelist of allowed HTTP request methods (comma-separated)
WAF_ALLOWED_METHODS=GET,POST,HEAD

# Sliding-window rate limit (requests per minute per source IP)
WAF_RATE_LIMIT_RPM=120
WAF_RATE_LIMIT_BURST=30

# Authentication brute-force defense (lockout threshold and duration)
WAF_AUTH_LOCKOUT_THRESHOLD=3
WAF_AUTH_LOCKOUT_SECONDS=60
WAF_AUTH_LOCKOUT_MAX_SECONDS=3600
WAF_AUTH_DECAY_SECONDS=300

# Directory discovery / path fuzzing (DIR_FUZZ) active defense controls
DIR_FUZZ_THRESHOLD=5
DIR_FUZZ_WINDOW_SECONDS=60
DIR_FUZZ_COOLDOWN_SECONDS=10
WAF_DIR_FUZZ_THROTTLE_SECONDS=60

# ==============================================================================
# HTTP Rate-Anomaly Detection & Extensible Detection Pipeline Controls
# ==============================================================================
# Enable or disable rate-anomaly detection
RATE_ANOMALY_ENABLED=true

# Sliding window in seconds and request count threshold to trigger rate anomaly alert
RATE_ANOMALY_WINDOW_SECONDS=10.0
RATE_ANOMALY_THRESHOLD=15

# Short burst window in seconds and burst threshold to flag rapid velocity spikes
RATE_ANOMALY_BURST_WINDOW_SECONDS=2.0
RATE_ANOMALY_BURST_THRESHOLD=8

# Debounced cooldown period (in seconds) suppressing duplicate alerts for the same source
RATE_ANOMALY_COOLDOWN_SECONDS=30.0

# Maximum tracked client identities to bound memory usage and prevent tracking exhaustion
RATE_ANOMALY_MAX_IDENTITIES=2000

# Health check and telemetry paths excluded from rate-anomaly monitoring
RATE_ANOMALY_EXCLUDED_PATHS=/health,/healthz,/actuator/health,/favicon.ico

# Excluded source IP addresses (comma-separated)
RATE_ANOMALY_EXCLUDED_IPS=

# Authorized reverse proxies permitted to supply forwarding headers (X-Forwarded-For, X-Real-IP)
TRUSTED_PROXIES=127.0.0.1,::1,localhost

# Machine-learning readiness investigative anomaly detector (true/false)
ML_DETECTOR_ENABLED=true


