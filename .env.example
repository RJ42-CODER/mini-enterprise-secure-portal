# ==============================================================================
# SECURE PORTAL & SECURITY AGENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure values for your environment.
# DO NOT commit real secrets or credentials into version control.
# ==============================================================================

# Protected Server Configuration
CN_SERVER_IP=192.168.31.91
PORT=5000

# Optional Portal Admin Credential Override (default: admin / admin123)
PORTAL_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Defensive SOC Dashboard Ingestion Integration
SOC_URL=http://192.168.31.73:8443
# Telemetry Bearer Token (both SOC_API_KEY and SOC_AGENT_TOKEN are accepted)
SOC_API_KEY=REPLACE_WITH_REAL_SOC_API_KEY
SOC_AGENT_TOKEN=REPLACE_WITH_REAL_SOC_AGENT_TOKEN

# Optional Custom Ingestion Endpoint Override (defaults to ${SOC_URL}/api/events)
# SOC_EVENTS_ENDPOINT=http://192.168.31.73:8443/api/events

# Network Telemetry Sniffer (Linux VM / Host-Only Adapter)
SNIFFER_INTERFACE=enp0s8
SNIFFER_ALLOW_LOCALHOST=True
MONITORED_PORTS=21,22,80,443,5050,8080

# ==============================================================================
# Web Application Firewall (WAF) & Request Filtering Controls
# ==============================================================================
# Enforcement mode: 'BLOCK' (active rejection) or 'MONITOR' (audit and telemetry only)
WAF_MODE=BLOCK

# Flask backend binding host ('127.0.0.1' ensures external clients cannot bypass Nginx reverse-proxy WAF)
FLASK_HOST=127.0.0.1

# Maximum permitted HTTP request body size (in bytes, default: 1048576 = 1 MB)
WAF_MAX_CONTENT_LENGTH=1048576

# Whitelist of allowed HTTP request methods (comma-separated)
WAF_ALLOWED_METHODS=GET,POST,HEAD

# Sliding-window rate limit (requests per minute per source IP)
WAF_RATE_LIMIT_RPM=120
WAF_RATE_LIMIT_BURST=30

# Authentication brute-force defense (lockout threshold and duration)
WAF_AUTH_LOCKOUT_THRESHOLD=3
WAF_AUTH_LOCKOUT_SECONDS=60
WAF_AUTH_DECAY_SECONDS=300

